{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AniMori",
  "version": "../package.json",
  "identifier": "com.foulnike.animori",
  "build": {
    "frontendDist": "../dist/app",
    "beforeBuildCommand": "npm run build:app",
    "beforeDevCommand": {
      "script": "npm run build:app",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
