{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // greasemonkey убран: это описания GM_*, которые даёт менеджер скриптов.
    // Здесь их нет и быть не может: своё окно, свой мост, свои права.
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,

    // Этап 2: SFC компилирует vue-tsc, ему нужен preserve.
    "jsx": "preserve",

    "noEmit": true,
    "sourceMap": true,

    "baseUrl": ".",
    "paths": {
      // Пункт 1.3: те же соответствия, что в resolve.alias. Править надо сразу
      // в двух файлах: расхождение даёт сборку, которая идёт, а проверка типов падает.
      "@/api/*": ["src/shared/api/*"],
      "@/bridge": ["src/shared/bridge/index"],
      "@/bridge/*": ["src/shared/bridge/*"],
      "@/core/*": ["src/shared/core/*"],
      "@/utils/*": ["src/shared/utils/*"],
      "@/*": ["src/*"],
      // Этап 3.4: реальную цель '@bridge-impl' выбирает resolve.alias: целей
      // теперь одна, и тайпчекеру больше не нужно выбирать между ними.
      "@bridge-impl": ["src/shared/bridge/TauriBridge"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src-tauri"]
}
